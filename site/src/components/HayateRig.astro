---
// Idle animation of the mascot: layered WebP from scripts/mascot_rig_export.py,
// moved with CSS (decision 0009). Each layer is a full-canvas image in stacking
// order. The outer div breathes and tilts with the head; the inner image sways
// or blinks around its own pivot. Reduced motion shows the still composite.
import { url } from "../lib";

const W = 404;
const H = 1296;

type Layer = { name: string; part?: "body" | "head"; motion?: "ponytail" | "scarf" | "blink" };
const layers: Layer[] = [
  { name: "back-hair", part: "head", motion: "ponytail" },
  { name: "footwear" },
  { name: "legwear" },
  { name: "arm-far", part: "body" },
  { name: "topwear", part: "body" },
  { name: "arm-near", part: "body" },
  { name: "eyebrow", part: "head" },
  { name: "neck", part: "body" },
  { name: "ears", part: "head" },
  { name: "face", part: "head" },
  { name: "mouth", part: "head" },
  { name: "neckwear", part: "body", motion: "scarf" },
  { name: "eyelash", part: "head", motion: "blink" },
  { name: "eyewhite", part: "head", motion: "blink" },
  { name: "irides", part: "head", motion: "blink" },
  { name: "front-hair", part: "head" },
];
---

<div class="rig" role="img" aria-label="Hayate standing with her hands in her pockets, grinning, her ponytail and scarf swaying" data-rig>
  {
    layers.map((l) => (
      <div class:list={["rig-layer", l.part]}>
        <img class={l.motion} src={url(`rig/${l.name}.webp`)} alt="" width={W} height={H} decoding="async" />
      </div>
    ))
  }
</div>

<style>
  .rig {
    position: relative;
    width: min(100%, 300px);
    aspect-ratio: 404 / 1296;
    margin: 8px auto 24px;
  }
  .rig-layer,
  .rig-layer img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Pivots, as a share of the 404 x 1296 canvas. */
  .body {
    animation: breathe 4.2s ease-in-out infinite;
  }
  .head {
    transform-origin: 42.6% 15.9%; /* neck */
    animation:
      breathe 4.2s ease-in-out infinite,
      tilt 7.3s ease-in-out infinite;
  }
  .ponytail {
    transform-origin: 33.9% 4.9%; /* hair tie */
    animation: sway 3.4s ease-in-out infinite;
  }
  .scarf {
    transform-origin: 39.1% 17.1%; /* knot */
    animation: sway-small 4.1s ease-in-out infinite;
  }
  .blink {
    transform-origin: 52.5% 10.5%; /* eye line */
  }
  .rig.blinking .blink {
    animation: blink 170ms ease-in-out;
  }
  @keyframes breathe {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.2%;
    }
  }
  @keyframes tilt {
    0%,
    100% {
      rotate: 0deg;
    }
    50% {
      rotate: 1.2deg;
    }
  }
  @keyframes sway {
    0%,
    100% {
      rotate: -1.6deg;
    }
    50% {
      rotate: 1.6deg;
    }
  }
  @keyframes sway-small {
    0%,
    100% {
      rotate: -0.8deg;
    }
    50% {
      rotate: 0.8deg;
    }
  }
  @keyframes blink {
    50% {
      scale: 1 0.08;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rig *,
    .rig.blinking .blink {
      animation: none;
    }
  }
</style>

<script>
  // Blink at random intervals; skipped when the tab is hidden or motion is reduced.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const rig of document.querySelectorAll<HTMLElement>("[data-rig]")) {
    rig.addEventListener("animationend", (e) => {
      if (e.animationName === "blink") rig.classList.remove("blinking");
    });
    const next = () => {
      if (!reduce.matches && !document.hidden) rig.classList.add("blinking");
      window.setTimeout(next, 2500 + Math.random() * 3500);
    };
    window.setTimeout(next, 1200);
  }
</script>
